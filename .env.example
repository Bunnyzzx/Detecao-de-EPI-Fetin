# URL base da API da IA de detecção de EPIs.
# Enquanto estiver vazia, o sistema opera com o serviço simulado.
# Ao preencher, o ApiEpiVerificationService passa a ser usado automaticamente.
VITE_EPI_API_URL=

# Timeout (ms) das requisições à API. Opcional.
VITE_EPI_API_TIMEOUT_MS=20000

# Segundos de espera antes de o terminal voltar sozinho à tela inicial.
VITE_TERMINAL_RESET_SECONDS=20
