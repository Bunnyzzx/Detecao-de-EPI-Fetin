# URL base da API de detecção de EPI.
# Enquanto estiver vazia, o aplicativo usa o MockEpiDetectionService.
# Ao preencher, o ApiEpiDetectionService passa a ser usado automaticamente.
EXPO_PUBLIC_EPI_API_URL=

# Timeout (ms) das requisições à API de detecção. Opcional.
EXPO_PUBLIC_EPI_API_TIMEOUT_MS=20000
